062194             0001*     ; =============================================================================
062194             0002*     ; Wolf3D logical sound batching and VDP playback transport.
062194             0003*     ;
062194             0004*     ; Gameplay calls begin/request/discard-or-flush once per 30 Hz simulation
062194             0005*     ; quantum.  Only the newest catch-up quantum is flushed.  The queue retains
062194             0006*     ; the three highest-priority loaded effects; equal priorities retain request
062194             0007*     ; order.  Playback uses the three default VDP channels in deterministic
062194             0008*     ; round-robin order and never waits for completion.
062194             0009*     ;
062194             0010*     ; Public producer ABI:
062194             0011*     ;   w3d_audio_begin_quantum
062194             0012*     ;   w3d_audio_request
062194             0013*     ;       A = AUDIOWL1 logical sound id (0..68)
062194             0014*     ;       B = mono gain (0..127; zero is a silent no-op)
062194             0015*     ;       C = metadata flags (bit 0 positioned; other bits reserved)
062194             0016*     ;       Carry clear when processed; carry set when inactive/invalid/missing.
062194             0017*     ;   w3d_audio_discard_quantum
062194             0018*     ;   w3d_audio_flush_quantum
062194             0019*     ;
062194             0020*     ; Loader/lifecycle ABI:
062194             0021*     ;   w3d_audio_initialize
062194             0022*     ;   w3d_audio_mark_sample_loaded         A = logical sound id
062194             0023*     ;   w3d_audio_mark_sample_buffer_loaded  HL = exact 0x5000+logical buffer id
062194             0024*     ;   w3d_audio_select_transport           A = BUFFERED or DIRECT
062194             0025*     ;   w3d_audio_install_available_command_buffers
062194             0026*     ;   w3d_audio_stop_channels
062194             0027*     ;   w3d_audio_shutdown
062194             0028*     ;
062194             0029*     ; IX and IY are preserved by producer/lifecycle entry points.  Other general
062194             0030*     ; registers are volatile.  The standard buffered playback procedure is:
062194             0031*     ; reset channel, select sample waveform, play whole sample at full volume.
062194             0032*     ; Runtime calls that procedure, then sets the requested mono gain while the
062194             0033*     ; new note is pending.  Direct diagnostic playback sends the same reset,
062194             0034*     ; waveform and play commands with gain embedded in the play command.
062194             0035*     ;
062194             0036*     ; Dependency: generated wolf3d_audio_assets.inc must be included first.  It
062194             0037*     ; owns the authoritative logical IDs, active AdLib SoundCommon priorities,
062194             0038*     ; stable buffer ranges, and manifest-derived sample/command table.
062194             0039*     ; =============================================================================
062194             0040*     
062194             0041*     W3D_AUDIO_FLAG_POSITIONED:     equ 00000001b
062194             0042*     W3D_AUDIO_TRANSPORT_BUFFERED:  equ 0
062194             0043*     W3D_AUDIO_TRANSPORT_DIRECT:    equ 1
062194             0044*     
062194             0045*     ; Installing all loaded-sample playback procedures is a uniquely dense VDU
062194             0046*     ; burst: unlike AGNB streaming, it contains no intervening FatFS reads.  The
062194             0047*     ; mode-info reply is used as an ordered ingress fence after each sample's
062194             0048*     ; three procedures.  These names remain local to the audio unit so its direct
062194             0049*     ; regression can include this file without depending on wolf3d.asm constants.
062194             0050*     W3D_AUDIO_MOS_CLEARVDPFLAGS:   equ 040h
062194             0051*     W3D_AUDIO_MOS_WAITFORVDPFLAGS: equ 041h
062194             0052*     W3D_AUDIO_VDP_PFLAG_MODE:      equ 00010000b
062194             0053*     
