0797EB             0001*     ; =============================================================================
0797EB             0002*     ; Ordinary player-death state machine.
0797EB             0003*     ;
0797EB             0004*     ; The eZ80 owns every durable transition. The VDP receives only render state
0797EB             0005*     ; and the asynchronous viewport-only fizzle command. Normal world simulation
0797EB             0006*     ; must call w3d_death_promote_lethal_latch after a complete actor pass, call
0797EB             0007*     ; w3d_death_fixed_step instead of ordinary simulation while it returns carry,
0797EB             0008*     ; pump w3d_death_foreground_update, and classify each submission with
0797EB             0009*     ; w3d_death_prepare_next_render.
0797EB             0010*     ;
0797EB             0011*     ; Hook ABIs:
0797EB             0012*     ;   bearing: A=killer slot -> carry clear and HL=0..359, or carry set invalid
0797EB             0013*     ;   fizzle:  DE=uint16 token -> carry clear once command bytes were accepted
0797EB             0014*     ;   reseed:  no arguments -> carry clear after the authoritative level world
0797EB             0015*     ;            has been rebuilt, without submitting a render
0797EB             0016*     ;   music:   no arguments; stop/restart the current floor track at the source
0797EB             0017*     ;            GameLoop death boundaries
0797EB             0018*     ;
0797EB             0019*     ; Hook setters take a 24-bit code pointer in HL. The defaults provide a real
0797EB             0020*     ; actor bearing and the frozen fizzle_to_red wire command. Reseed deliberately
0797EB             0021*     ; fails closed until the level-reset owner supplies a complete implementation.
0797EB             0022*     ; =============================================================================
0797EB             0023*     
0797EB             0024*     W3D_DEATH_PHASE_ALIVE:                equ 0
0797EB             0025*     W3D_DEATH_PHASE_WAIT_DEAD_FRAME:      equ 1
0797EB             0026*     W3D_DEATH_PHASE_TURN:                 equ 2
0797EB             0027*     W3D_DEATH_PHASE_WAIT_TARGET_FRAME:    equ 3
0797EB             0028*     W3D_DEATH_PHASE_WAIT_TARGET_SYNC_FRAME: equ 4
0797EB             0029*     W3D_DEATH_PHASE_WAIT_FIZZLE:          equ 5
0797EB             0030*     W3D_DEATH_PHASE_HOLD:                 equ 6
0797EB             0031*     W3D_DEATH_PHASE_RESEED:               equ 7
0797EB             0032*     W3D_DEATH_PHASE_WAIT_RESPAWN_FRAME:   equ 8
0797EB             0033*     W3D_DEATH_PHASE_GAME_OVER:            equ 9
0797EB             0034*     
0797EB             0035*     ; DEATHROTATE=2 at the original 70 Hz is exactly 140 degrees/second. At this
0797EB             0036*     ; client's 30 Hz fixed step, 4,4,6 repeats to the same rate without fractions.
0797EB             0037*     W3D_DEATH_TURN_STEP_A:                equ 4
0797EB             0038*     W3D_DEATH_TURN_STEP_B:                equ 6
0797EB             0039*     W3D_DEATH_HOLD_STEPS:                 equ 43
