066BDA             0068*     ; Prime the 24-bit 120 Hz MOS clock so the first control-loop delta is zero
066BDA             0069*     ; rather than the machine's full uptime. Future fixed-step simulation can
066BDA             0070*     ; consume w3d_elapsed_ticks without changing the render-completion lifecycle.
066BDA             0071*     w3d_initialize_control_clock:
066BDA             0072*         MOSCALL mos_sysvars
                       M1 Args: function=mos_sysvars 
066BDA 3E 08       0001*M1           ld a,function
066BDC 5B CF       0002*M1           rst.lil 08h
066BDE DD 22 A7 70 0073*         ld (w3d_sysvars_pointer),ix
       06          
066BE3 DD 27 00    0074*         ld hl,(ix+sysvar_time)
066BE6 22 AA 70 06 0075*         ld (w3d_timestamp_now),hl
066BEA 21 00 00 00 0076*         ld hl,0
066BEE 22 AD 70 06 0077*         ld (w3d_elapsed_ticks),hl
066BF2 C9          0078*         ret
066BF3             0079*     
066BF3             0080*     w3d_tick_control_clock:
066BF3 DD 2A A7 70 0081*         ld ix,(w3d_sysvars_pointer)
       06          
066BF8 DD 27 00    0082*         ld hl,(ix+sysvar_time)
066BFB ED 5B AA 70 0083*         ld de,(w3d_timestamp_now)
       06          
066C00 22 AA 70 06 0084*         ld (w3d_timestamp_now),hl
066C04 B7          0085*         or a
066C05 ED 52       0086*         sbc hl,de
066C07 22 AD 70 06 0087*         ld (w3d_elapsed_ticks),hl
066C0B C9          0088*         ret
066C0C             0089*     
066C0C             0090*     ; A=purpose for the next render submission. Unknown purposes are permitted so
066C0C             0091*     ; future presentation phases can be added without revising this mailbox ABI.
066C0C             0092*     w3d_set_next_render_purpose:
066C0C 32 85 70 06 0093*         ld (w3d_next_render_purpose),a
066C10 C9          0094*         ret
066C11             0095*     
066C11             0096*     ; Publish the in-flight state before any render byte reaches the VDP. Carry is
066C11             0097*     ; clear on success. Carry is set and the callback fault latch is raised if a
066C11             0098*     ; caller attempts to overlap render and fizzle ownership.
066C11             0099*     w3d_mark_render_submitted:
066C11 3A 84 70 06 0100*         ld a,(w3d_async_owner)
066C15 B7          0101*         or a
066C16 20 2B       0102*         jr nz,@owner_conflict
066C18 3A 61 70 06 0103*         ld a,(w3d_render_in_flight)
066C1C B7          0104*         or a
066C1D 20 24       0105*         jr nz,@owner_conflict
066C1F AF          0106*         xor a
066C20 32 62 70 06 0107*         ld (w3d_completion_ready),a
066C24 32 88 70 06 0108*         ld (w3d_render_event_ready),a
066C28 3A 85 70 06 0109*         ld a,(w3d_next_render_purpose)
066C2C 32 86 70 06 0110*         ld (w3d_render_in_flight_purpose),a
066C30 AF          0111*         xor a
