07923B CA 44 EA 05 0104*         jp z,w3d_music_start_current_floor
07923F FE 07       0105*         cp w3d_panel_request_end_game
079241 D0          0106*         ret nc
079242 C3 44 EA 05 0107*         jp w3d_music_start_current_floor
