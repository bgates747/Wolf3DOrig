079222 AF          0091*         xor a
079223 32 46 92 07 0092*         ld (w3d_gameplay_backdrop_active),a
079227 21 00 47 00 0093*         ld hl,W3D_GAMEPLAY_BACKDROP_BUFFER
07922B C3 7C 07 04 0094*         jp vdu_clear_buffer
07922F             0095*     
07922F             0096*     ; F1-F6/Escape restart floor music after the full panel. F9 does so even for
07922F             0097*     ; its remembered-slot confirmation. F7, remembered F8, F10, MLI and BAT leave
07922F             0098*     ; the track untouched. Pause resumes its frozen sequencer position separately.
07922F             0099*     w3d_gameplay_panel_resume_music:
07922F 3A 7B 70 06 0100*         ld a,(w3d_gameplay_panel_request)
079233 FE 0B       0101*         cp w3d_panel_request_pause
079235 CA C8 E9 05 0102*         jp z,w3d_music_resume
