066B60             0078          include "wolf3d_render_async.inc"
066B60             0001*     ; =============================================================================
066B60             0002*     ; Wolf3D render-completion control-loop support.
066B60             0003*     ;
066B60             0004*     ; One presentation producer may be in flight. The interrupt callback only
066B60             0005*     ; recognizes and routes the ten-byte W3DR payload; all validation and VDU
066B60             0006*     ; presentation work remains in the foreground. Event 1 completes a render;
066B60             0007*     ; event 2 completes a VDP-owned fizzle. Non-W3DR records continue through
066B60             0008*     ; normal MOS keyboard handling, with Escape latched as a shutdown request.
066B60             0009*     ;
066B60             0010*     ; This mirrors the proven earth-party-local ownership model while remaining
066B60             0011*     ; Wolf3D-native: the eZ80 owns frame presentation and future simulation state;
066B60             0012*     ; the VDP reports only that its submitted render has completed.
066B60             0013*     ; =============================================================================
066B60             0014*     
066B60             0015*     w3d_render_notify_token: equ 0573Dh
066B60             0016*     
066B60             0017*     W3D_RENDER_EVENT_COMPLETE:        equ 1
066B60             0018*     W3D_RENDER_EVENT_FIZZLE_COMPLETE: equ 2
066B60             0019*     
066B60             0020*     W3D_ASYNC_OWNER_NONE:             equ 0
066B60             0021*     W3D_ASYNC_OWNER_RENDER:           equ 1
066B60             0022*     W3D_ASYNC_OWNER_FIZZLE:           equ 2
066B60             0023*     
066B60             0024*     ; A purpose is latched at submission rather than inferred at completion.
066B60             0025*     ; This keeps a slow callback from advancing a newer death phase by mistake.
066B60             0026*     W3D_RENDER_PURPOSE_NORMAL:        equ 0
066B60             0027*     W3D_RENDER_PURPOSE_DEAD_FACE:     equ 1
066B60             0028*     W3D_RENDER_PURPOSE_DEATH_TURN:    equ 2
066B60             0029*     W3D_RENDER_PURPOSE_DEATH_TARGET:  equ 3
066B60             0030*     W3D_RENDER_PURPOSE_DEATH_TARGET_SYNC: equ 4
066B60             0031*     W3D_RENDER_PURPOSE_RESPAWN:       equ 5
066B60             0032*     
066B60             0033*     w3d_initialize_render_state:
066B60             0034*     ; TODO: if the scratch area is contiguous we can use ldir to clear the whole block.
066B60 AF          0035*         xor a
066B61 32 61 70 06 0036*         ld (w3d_render_in_flight),a
066B65 32 62 70 06 0037*         ld (w3d_completion_ready),a
066B69 32 79 70 06 0038*         ld (w3d_sequence_initialized),a
066B6D 32 7A 70 06 0039*         ld (w3d_exit_requested),a
066B71 32 7B 70 06 0040*         ld (w3d_gameplay_panel_request),a
066B75 32 7C 70 06 0041*         ld (w3d_pause_ack_armed),a
066B79 32 7D 70 06 0042*         ld (w3d_pause_ack_requested),a
066B7D 32 7E 70 06 0043*         ld (w3d_shell_callback_active),a
066B81 32 7F 70 06 0044*         ld (w3d_shell_pause_toggle_enabled),a
066B85 32 80 70 06 0045*         ld (w3d_shell_pause_toggle_requested),a
066B89 32 81 70 06 0046*         ld (w3d_shell_pause_key_down),a
066B8D 32 82 70 06 0047*         ld (w3d_callback_error),a
066B91 32 83 70 06 0048*         ld (w3d_frame_presented),a
066B95 32 84 70 06 0049*         ld (w3d_async_owner),a
066B99 32 85 70 06 0050*         ld (w3d_next_render_purpose),a
066B9D 32 86 70 06 0051*         ld (w3d_render_in_flight_purpose),a
066BA1 32 87 70 06 0052*         ld (w3d_completed_render_purpose),a
