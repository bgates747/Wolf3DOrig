04080E             0026*     ;
04080E             0027*     ; AGNB 0.1 image-container layout
04080E             0028*     ; ===============================
04080E             0029*     ;
04080E             0030*     ; AGNB is a RIFF container. All integer fields are unsigned little-endian.
04080E             0031*     ; Every chunk begins with a four-byte ID and a u32 payload size. The payload
04080E             0032*     ; follows immediately and is padded with zero bytes to a four-byte boundary.
04080E             0033*     ; The stored chunk size excludes its eight-byte header and alignment padding.
04080E             0034*     ;
04080E             0035*     ;     RIFF  u32(file size - 8)  AGNB
04080E             0036*     ;       VERS  size=2
04080E             0037*     ;         u8 major=0
04080E             0038*     ;         u8 minor=1
04080E             0039*     ;       LIST  type=BUFR
04080E             0040*     ;         BHDR  size=2
04080E             0041*     ;           u16 bufferId
04080E             0042*     ;         IMAG  size=5
04080E             0043*     ;           u16 width
04080E             0044*     ;           u16 height
04080E             0045*     ;           u8  format=1        ; RGBA2222
04080E             0046*     ;         DATA  size=width*height
04080E             0047*     ;           u8 pixels[]         ; row-major, no row padding
04080E             0048*     ;
04080E             0049*     ; VERS occurs once before the LIST records. Each version 0.1 LIST BUFR record
04080E             0050*     ; contains exactly BHDR, IMAG, and DATA in that order. The LIST payload starts
04080E             0051*     ; with its four-byte BUFR type, followed by those nested chunks. Readers must
04080E             0052*     ; validate the enclosing RIFF/LIST bounds and the BHDR/IMAG metadata before
04080E             0053*     ; reading or uploading DATA. Chunk traversal advances by:
04080E             0054*     ;
04080E             0055*     ;     8 + ((payload_size + 3) & ~3)
04080E             0056*     ;
04080E             0057*     ; The offsets below are indices from the beginning of the named header or
04080E             0058*     ; payload. RIFF and chunk sizes are u32 values even though ADL registers are
04080E             0059*     ; 24-bit, so their high byte must not be silently discarded during validation.
04080E             0060*     
04080E             0061*     ; RIFF file header: "RIFF", u32 size, "AGNB"
04080E             0062*     agnb_riff_id:              equ 0
04080E             0063*     agnb_riff_size:            equ 4
04080E             0064*     agnb_riff_form:            equ 8
04080E             0065*     agnb_riff_header_size:     equ 12
04080E             0066*     
04080E             0067*     ; Generic RIFF chunk header: FourCC ID, u32 payload size
04080E             0068*     agnb_chunk_id:             equ 0
04080E             0069*     agnb_chunk_size:           equ 4
04080E             0070*     agnb_chunk_data:           equ 8
04080E             0071*     agnb_chunk_header_size:    equ 8
04080E             0072*     
04080E             0073*     ; VERS payload
04080E             0074*     agnb_vers_major:           equ 0
04080E             0075*     agnb_vers_minor:           equ 1
04080E             0076*     agnb_vers_payload_size:    equ 2
04080E             0077*     
04080E             0078*     ; LIST BUFR payload
04080E             0079*     agnb_list_type:            equ 0
04080E             0080*     agnb_list_chunks:          equ 4
04080E             0081*     agnb_list_type_size:       equ 4
04080E             0082*     
