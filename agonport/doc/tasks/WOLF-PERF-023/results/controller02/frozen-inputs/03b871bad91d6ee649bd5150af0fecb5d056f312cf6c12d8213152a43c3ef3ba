0791A9             0093          include "wolf3d_panel_music.inc"
0791A9             0001*     ; Gameplay-to-shell music policy for original CheckKeys requests.
0791A9             0002*     ;
0791A9             0003*     ; M+L+I and B+A+T display ordinary Message()/IN_Ack modals without entering
0791A9             0004*     ; US_ControlPanel, so the current floor track continues uninterrupted. Source
0791A9             0005*     ; CheckKeys also treats F7-F10 as quick overlays over the live play screen;
0791A9             0006*     ; only F1-F6/Escape enter the full panel and select MENUSONG (WONDERIN).
0791A9             0007*     ; First-use F8/F9 promotion into the full save/load pages is handled where the
0791A9             0008*     ; shell discovers that no remembered slot exists.
0791A9             0009*     
0791A9             0010*     ; VDP 2.6+ screen capture produces a mode-independent RGBA2222 bitmap. Keep
0791A9             0011*     ; the original CP_CheckQuick/Message() presentation over the stopped gameplay
0791A9             0012*     ; frame while the retained double-buffered shell owns presentation.
0791A9             0013*     W3D_GAMEPLAY_BACKDROP_BUFFER: equ $4700
0791A9             0014*     
0791A9             0015*     ; A=request. Return Z for requests which preserve floor music on entry.
0791A9             0016*     w3d_panel_request_preserves_floor_music_on_open:
0791A9 FE 07       0017*         cp w3d_panel_request_end_game
0791AB 30 03       0018*         jr nc,@preserve
0791AD F6 01       0019*         or 1
0791AF C9          0020*         ret
0791B0             0021*     @preserve:
0791B0 BF          0022*         cp a
0791B1 C9          0023*         ret
0791B2             0024*     
0791B2             0025*     ; Start control-panel music only when the request actually enters that panel.
0791B2             0026*     w3d_gameplay_panel_open_music:
0791B2 3A 7B 70 06 0027*         ld a,(w3d_gameplay_panel_request)
0791B6 CD A9 91 07 0028*         call w3d_panel_request_preserves_floor_music_on_open
0791BA C8          0029*         ret z
0791BB 3E 0E       0030*         ld a,W3D_MUSIC_WONDERIN
0791BD C3 FC E8 05 0031*         jp w3d_music_start
0791C1             0032*     
0791C1             0033*     ; A=request. Return Z when the source draws a quick Message()/confirmation
0791C1             0034*     ; over the play screen rather than entering the full control-panel surface.
0791C1             0035*     ; F8/F9 are classified here even on first use; their fallback pages simply
0791C1             0036*     ; cover the captured image after promoting the request to full Save/Load.
0791C1             0037*     w3d_panel_request_uses_gameplay_backdrop:
0791C1 FE 0B       0038*         cp w3d_panel_request_pause
0791C3 28 04       0039*         jr z,@does_not_use
0791C5 FE 07       0040*         cp w3d_panel_request_end_game
0791C7 30 03       0041*         jr nc,@uses
0791C9             0042*     @does_not_use:
0791C9 F6 01       0043*         or 1
0791CB C9          0044*         ret
0791CC             0045*     @uses:
0791CC BF          0046*         cp a
0791CD C9          0047*         ret
0791CE             0048*     
0791CE             0049*     ; Capture the current draw surface before MODE 8+128 is replaced. After a C3
0791CE             0050*     ; presentation FabGL's canvas names the other physical surface, so this may be
0791CE             0051*     ; the immediately preceding 30-Hz frame; it is nevertheless a real stopped
0791CE             0052*     ; gameplay frame and avoids a destructive black shell clear. The two native
0791CE             0053*     ; absolute moves define an inclusive 320x240 rectangle on VDP 2.6+.
0791CE             0054*     w3d_gameplay_backdrop_capture:
0791CE 3A 7B 70 06 0055*         ld a,(w3d_gameplay_panel_request)
0791D2 CD C1 91 07 0056*         call w3d_panel_request_uses_gameplay_backdrop
0791D6 28 06       0057*         jr z,@capture
0791D8 AF          0058*         xor a
0791D9 32 46 92 07 0059*         ld (w3d_gameplay_backdrop_active),a
0791DD C9          0060*         ret
0791DE             0061*     @capture:
0791DE 21 EF 91 07 0062*         ld hl,@commands
0791E2 01 13 00 00 0063*         ld bc,@end-@commands
0791E6 5B DF       0064*         rst.lil 18h
0791E8 3E 01       0065*         ld a,1
0791EA 32 46 92 07 0066*         ld (w3d_gameplay_backdrop_active),a
0791EE C9          0067*         ret
0791EF             0068*     @commands:
0791EF 19 04       0069*         db 25,4
0791F1 00 00 00 00 0070*         dw 0,0
0791F5 19 04       0071*         db 25,4
0791F7 3F 01 EF 00 0072*         dw 319,239
0791FB 17 1B 21    0073*         db 23,27,$21
0791FE 00 47 00 00 0074*         dw W3D_GAMEPLAY_BACKDROP_BUFFER,0
079202             0075*     @end:
079202             0076*     
079202             0077*     w3d_gameplay_backdrop_plot:
079202 3A 46 92 07 0078*         ld a,(w3d_gameplay_backdrop_active)
079206 B7          0079*         or a
079207 C8          0080*         ret z
079208 21 00 47 00 0081*         ld hl,W3D_GAMEPLAY_BACKDROP_BUFFER
07920C CD E1 5F 08 0082*         call selectBitmap
079210 01 00 00 00 0083*         ld bc,0
079214 11 00 00 00 0084*         ld de,0
